# ==============================================================================
# MAJORSTAY - Variáveis de Ambiente
# ==============================================================================

# --- FIREBASE CLIENT (Obrigatórias no Vercel e localmente em .env.local) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- FIREBASE ADMIN / SERVIDOR (Obrigatória no Vercel e no servidor) ---
# Conteúdo JSON completo (em uma só linha) da chave da Conta de Serviço do Firebase
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- SEGURANÇA E SESSÃO (Recomendadas) ---
# Segredo aleatório para proteger as sessões temporárias de teste
GUEST_TRIAL_PEPPER=

# --- SERVIÇOS EXTERNOS (Opcionais) ---
# Envio de emails transacionais (se configurado)
RESEND_API_KEY=
# Chave Google Gemini (se funcionalidades de IA estiverem ativas)
GEMINI_API_KEY=
